# Landing Reviewer — Environment Variables (FREE tier only)
# Copy to .env.local and fill in your values

# Supabase (free tier at supabase.com) - REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key  # Server-side only!

# GitHub Actions (for background workers) - REQUIRED
GITHUB_ACTIONS_TOKEN=ghp_your-personal-access-token  # Classic PAT with "repo" scope
GITHUB_REPO=your-github-username/landing-reviewer-mvp

# Ollama (local AI) - REQUIRED
# Run: ollama pull qwen2-vl:7b && ollama serve
# Then expose via: ngrok http 11434 OR cloudflared tunnel --url http://localhost:11434
OLLAMA_URL=https://your-ngrok-url.ngrok-free.app  # Your public tunnel URL
OLLAMA_MODEL=qwen2-vl:7b

# Resend for magic link emails (free 3k/month at resend.com)
RESEND_API_KEY=re_your-key
EMAIL_FROM=Landing Reviewer <noreply@yourdomain.com>

# Upstash Redis for rate limiting (free 10k/day at upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage buckets (create in Supabase Dashboard: Storage > Buckets)
# screenshots - for screenshot images
# pdfs - for generated PDF reports